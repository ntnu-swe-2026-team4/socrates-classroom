{
  "plugins": ["./node_modules/biome-plugin-tanstack-query/rules/recommended-strict.grit"],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.cloudflare",
      "!**/public",
      "!**/node_modules",
      "!**/*.sql",
      "!**/package-lock.json",
      "!/skills-lock.json",
      "!**/routeTree.gen.ts",
      "!**/config.gen.ts",
      "!.agents",
      "!.claude",
      "!.playwright-cli",
      "!apps/server/src/prompts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react": {
                "importNames": ["useEffect"],
                "message": "useEffect is banned in apps/web"
              }
            }
          }
        }
      },
      "complexity": {
        "noVoid": "off"
      },
      "nursery": {
        "useReactCompiler": "error"
      },
      "a11y": {
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off",
        "useAnchorContent": "off",
        "useSemanticElements": "warn",
        "noLabelWithoutControl": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "warn"
      }
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  }
}
