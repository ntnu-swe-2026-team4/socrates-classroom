{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "socrates-server-test",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.md", "**/*.sql"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "socrates-test", "database_id": "local-test" }],
  "durable_objects": {
    "bindings": [
      { "name": "PiAgent", "class_name": "PiAgent" },
      { "name": "ActivityEvents", "class_name": "ActivityEvents" },
      { "name": "Coordinator", "class_name": "Coordinator" },
      { "name": "ReportJob", "class_name": "ReportJob" }
    ]
  },
  "migrations": [{ "tag": "v3", "new_sqlite_classes": ["PiAgent", "ActivityEvents", "Coordinator", "ReportJob"] }],
  "vars": {
    "LLM_PROVIDER": "mock",
    "PUBLIC_BASE_URL": "",
    "COOKIE_SECURE": "false"
  }
}
