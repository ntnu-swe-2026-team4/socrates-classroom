{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "socrates-server-test",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.md", "**/*.sql"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "socrates-test", "database_id": "local-test" }],
  "durable_objects": {
    "bindings": [{ "name": "Chat", "class_name": "Chat" }, { "name": "ReportRunner", "class_name": "ReportRunner" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Chat", "ReportRunner"] }],
  "vars": {
    // Test-only fixtures sharing names with production secrets; never real credentials.
    "LLM_PROVIDER": "mock",
    "FAUX_TOKENS_PER_SECOND": "4",
    "PUBLIC_BASE_URL": "",
    "SEED_TOKEN": "dev-seed-token",
    "AUTH_SECRET": "test-auth-secret",
    "BYOK_ENC_KEY": "test-byok-enc-key"
  }
}
