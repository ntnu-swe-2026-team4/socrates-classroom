# ── vars（cloudflare.config.ts 的 plain var 無法被 .dev.vars 覆寫——用環境變數在 config 求值時覆寫）──
# 公開網址（產生檔案下載連結用；留空 = 相對路徑 /api/files/:id）
PUBLIC_BASE_URL=
# 只有 HTTPS 時設 true（production 在 cloudflare.config.ts 已設）
COOKIE_SECURE=false
# 開發時 Vite 的網址（逗號分隔）；同源部署（assets + /api）時留空
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# provider 模式：pool（預設生產鏈）| dev（Coding Plan 優先）| mock（離線測試）
LLM_PROVIDER=pool
# 自架 DGX Spark 的 Cloudflare Tunnel 位址（未設定 = pool 跳過該段）
DGX_BASE_URL=
# 啟用 POST /api/dev/seed 的 token（npm run seed 用）
SEED_TOKEN=

# ── secrets（正式環境用 cf deploy --secrets-file 或 wrangler secret put）──
# OpenCode Go / Zen（pool 第二段）
OPENCODE_API_KEY=
# OpenRouter（pool 第三段＋學生 BYOK 通道）
OPENROUTER_API_KEY=
# Z.AI Coding Plan Global（LLM_PROVIDER=dev 時用；不進學生流量）
ZAI_API_KEY=
# 學生 BYOK key 的 AES-GCM 加密金鑰（base64 的 32 bytes；openssl rand -base64 32）
BYOK_ENC_KEY=
