# Copy to .env.local (gitignored). Everything is optional except the two REQUIRED secrets below.
# Missing AUTH_SECRET breaks login (every session-issuing endpoint returns 500);
# missing BYOK_ENC_KEY breaks the teacher-key endpoints (/settings/keys*).
# Only pnpm dev (mode=development) reads this file; build/deploy always use cloudflare.config.ts defaults.
# Full guide: docs/development.md

# ── text bindings (dev overrides config defaults; production unaffected) ──
# Public origin for join links; empty = relative path /join/:code
PUBLIC_BASE_URL=
# "dev" mounts /api/dev/* and /dev/accounts; empty = auto ("dev" under pnpm dev, "production" for build/deploy)
ENVIRONMENT=
# mock = faux provider (zero-account offline dev); any other value = real routing via providers.config.yaml. Production defaults to real routing — it never silently falls back to mock
LLM_PROVIDER=mock
# Self-hosted DGX Spark origin — inert unless the dgx-spark provider block exists in providers.config.yaml
DGX_BASE_URL=
# Token that enables POST /api/dev/seed (the only seed gate — no LLM-mode coupling)
SEED_TOKEN=dev-seed
# Workers AI TTS model id (empty = config default xai/grok-tts)
TTS_MODEL=
# Faux provider playback speed in tokens/second (mock dev mode only)
FAUX_TOKENS_PER_SECOND=
# true = dev also uses real Workers AI (requires cf login); default off = zero-account dev. Read from the shell environment, not this file
CF_REMOTE_AI=

# Google OAuth client ID; empty = Google login disabled (see docs/google-oauth.md). Google login also needs PUBLIC_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=

# ── quota alerts (email) ──
# Sender address for teacher BYOK quota warnings (must be an address of the zone); empty = alerts log-only
ALERT_FROM_EMAIL=
# Admin address also notified at each quota threshold; empty = teacher-only alerts
ADMIN_ALERT_EMAIL=

# ── secrets (dev also reads these from this file when .env is absent) ──
# REQUIRED for login — generate with: openssl rand -base64 32
AUTH_SECRET=
# REQUIRED for teacher keys — generate with: openssl rand -base64 32
BYOK_ENC_KEY=
# Google OAuth client secret (GOCSPX-…); empty = Google login disabled
GOOGLE_CLIENT_SECRET=
