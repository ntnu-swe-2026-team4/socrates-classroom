# Copy to .env (gitignored). All optional — dev server starts without any of them.
# Only pnpm dev (mode=development) reads this file; build/deploy always use cloudflare.config.ts defaults.
# Full guide: docs/development.md

# ── text bindings (dev overrides config defaults; production unaffected) ──
# Public origin for join links; empty = relative path /join/:code
PUBLIC_BASE_URL=
# mock = faux provider (zero-account offline dev); any other value = real routing via providers.config.yaml. Production defaults to real routing — it never silently falls back to mock
LLM_PROVIDER=mock
# Self-hosted DGX Spark origin — inert unless the dgx-spark provider block exists in providers.config.yaml
DGX_BASE_URL=
# Token that enables POST /api/dev/seed (the only seed gate — no LLM-mode coupling)
SEED_TOKEN=dev-seed
# Workers AI TTS model id (empty = config default @cf/myshell-ai/melotts)
TTS_MODEL=
# Faux provider playback speed in tokens/second (mock dev mode only)
FAUX_TOKENS_PER_SECOND=
# true = dev also uses real Workers AI (requires cf login); default off = zero-account dev. Read from the shell environment, not this file
CF_REMOTE_AI=

# ── secrets (dev also reads these from this file when .env is absent) ──
# HMAC session cookie signing key (openssl rand -base64 32)
AUTH_SECRET=
# AES-GCM key for teacher keys (base64 32 bytes; openssl rand -base64 32)
BYOK_ENC_KEY=
