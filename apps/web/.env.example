# 複製為 .env（gitignored）。全部選填——不設也能啟動 dev server。
# 僅 pnpm dev（mode=development）會讀；build/deploy 一律用 cloudflare.config.ts 的預設值。
# 完整說明見 docs/development.md

# ── text bindings（dev 時覆寫 config 預設；production 不受影響）──
# 公開網址（產生 join 連結用；留空 = 相對路徑 /join/:code）
PUBLIC_BASE_URL=
# 只有 HTTPS 時才需要 true（production 在 cloudflare.config.ts 已設）
COOKIE_SECURE=false
# mock = faux provider（零帳號離線開發）；其他值 = 走 providers.config.yaml 的真實路由
LLM_PROVIDER=mock
# 自架 DGX Spark 位址（routing 的其中一個 leg；未設 = 該 leg 不參與）
DGX_BASE_URL=
# 啟用 POST /api/dev/seed 的 token
SEED_TOKEN=dev-seed
# Workers AI TTS model id（留空 = config 預設 @cf/myshell-ai/melotts）
TTS_MODEL=
# true 時 dev 也接真實 Workers AI（需要 cf login）；預設關閉 = 零帳號開發。此項讀 shell 環境變數，放本檔無效
CF_REMOTE_AI=

# ── secrets（無 .env 時，dev 同樣從本檔讀）──
# HMAC session cookie 簽章金鑰（openssl rand -base64 32）
AUTH_SECRET=
# teacher keys 的 AES-GCM 加密金鑰（base64 的 32 bytes；openssl rand -base64 32）
BYOK_ENC_KEY=
