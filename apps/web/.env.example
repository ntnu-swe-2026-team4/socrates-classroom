# 複製為 .dev.vars（gitignored）。全部選填——不設也能啟動 dev server。
# 完整說明見 docs/development.md

# ── vars（plain var，.dev.vars 蓋不動；用環境變數在 config 求值時覆寫）──
# 公開網址（產生檔案下載連結用；留空 = 相對路徑 /api/files/:id）
PUBLIC_BASE_URL=
# 只有 HTTPS 時才需要 true（production 在 cloudflare.config.ts 已設）
COOKIE_SECURE=false
# 本機前端網址（同源部署時留空）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 對話路由：pool（白名單鏈）| dev（GLM Coding Plan 優先，dev-only 條款）| mock（離線測試）
LLM_PROVIDER=pool
# 自架 DGX Spark 的 Cloudflare Tunnel／Tailscale 位址（未設 = 跳過該段）
DGX_BASE_URL=
# 啟用 POST /api/dev/seed 的 token（pnpm seed 用）
SEED_TOKEN=
# true 時 dev 也接真實 Workers AI（需要 cf login）；預設關閉 = 零帳號開發
CF_REMOTE_AI=

# ── secrets（.dev.vars 可直接覆寫）──
# OpenCode Go / Zen（pool 第二段）
OPENCODE_API_KEY=
# OpenRouter（pool 第三段＋學生 BYOK 通道）
OPENROUTER_API_KEY=
# Z.AI／GLM Coding Plan（LLM_PROVIDER=dev 時第一棒；dev-only 條款，不進學生流量）
ZAI_API_KEY=
# 學生 BYOK key 的 AES-GCM 加密金鑰（base64 的 32 bytes；openssl rand -base64 32）
BYOK_ENC_KEY=
