# HTTP
PORT=8000
# SQLite 資料庫檔案（相對於 server/，也可用絕對路徑）
DATABASE_PATH=./data/socrates.db
# 上傳檔案放這裡
UPLOAD_DIR=./data/uploads
# 只有透過 HTTPS 提供服務時才設 true
COOKIE_SECURE=false
# 開發時 Vite 的網址（逗號分隔）；直接跨網域呼叫 API 時才需要
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 產生檔案下載網址時用的公開網址（留空 = 相對路徑 /api/files/:id）
PUBLIC_BASE_URL=

# LLM（GLM / 智譜 Z.ai；OpenAI 相容 API）
# key 只放後端，絕對不要放進前端或 VITE_ 變數
GLM_API_KEY=
GLM_MODEL=glm-4.6
# 留空 = 讀 llm/providers/models.json 的 providers.glm.baseUrl
# Coding Plan：https://api.z.ai/api/coding/paas/v4　一般 API：https://open.bigmodel.cn/api/paas/v4
GLM_BASE_URL=
# 名詞查詢預設用 Exa / Keenable / DuckDuckGo（免 key）；只有 llm/lookup/search.json 的 provider 含 tavily 時才需要（https://app.tavily.com）
TAVILY_API_KEY=
# 沒有 key 時可設 mock，讓對話用規則式回覆（僅供本機開發與測試；正式環境留空）
LLM_PROVIDER=
# 第一次啟動空資料庫時建立示範教室
SEED_DEMO=true
