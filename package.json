{
  "name": "socrates-classroom",
  "private": true,
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "dev": "cd frontend && bun run dev",
    "dev:server": "cd server && bun run dev",
    "build": "cd frontend && bun run build",
    "typecheck": "cd frontend && bun run typecheck && cd ../server && bun run typecheck",
    "test": "cd server && bun test",
    "migrate": "cd server && bun run migrate",
    "seed": "cd server && bun run seed"
  }
}
