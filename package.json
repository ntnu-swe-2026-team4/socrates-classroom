{
  "name": "socrates-classroom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.12",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter @socrates/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @socrates/server test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "migrate": "pnpm --filter @socrates/web migrate",
    "seed": "pnpm --filter @socrates/server seed",
    "deploy": "pnpm --filter @socrates/web deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4"
  }
}
